          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "welcome-if",
      "name": "Tem profile_id?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-420, 700]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.enqueue_welcome($1::uuid) AS outbox_id;",
        "options": {
          "queryReplacement": "={{ $json.body.data.profile_id }}"
        }
      },
      "id": "welcome-enqueue",
      "name": "Enfileirar boas-vindas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-200, 660],
      "credentials": {
        "postgres": { "id": "REPLACE_POSTGRES_CRED_ID", "name": "Supabase Postgres" }
      },
      "notes": "A função busca profiles.phone, normaliza (DDI 55) e grava na fila. Se o perfil não tiver telefone ou estiver em opt-out, não enfileira nada."
    },
    {
      "parameters": {},
      "id": "welcome-skip",
      "name": "Ignorar signup",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [-200, 800]
    },

